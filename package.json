{
  "name": "stackstracker-monorepo",
  "private": true,
  "scripts": {
    "dev": "cd frontend && pnpm dev",
    "build": "cd frontend && pnpm build",
    "frontend:install": "cd frontend && pnpm install",
    "contracts:check": "cd stackstracker && clarinet check",
    "contracts:console": "cd stackstracker && clarinet console",
    "contracts:deploy": "cd stackstracker && clarinet deploy",
    "start": "pnpm run dev"
  },
  "devDependencies": {
    "@stacks/blockchain-api-client": "^7.0.0",
    "@stacks/connect": "^7.0.0",
    "@stacks/transactions": "^6.0.0"
  }
}
